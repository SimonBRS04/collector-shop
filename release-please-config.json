{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "collector",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Fonctionnalités" },
    { "type": "fix", "section": "Corrections" },
    { "type": "perf", "section": "Performances" },
    { "type": "refactor", "section": "Refactorisation" },
    { "type": "docs", "section": "Documentation" },
    { "type": "ci", "section": "Pipeline et infrastructure" },
    { "type": "test", "section": "Tests" },
    { "type": "build", "section": "Pipeline et infrastructure" },
    { "type": "chore", "section": "Maintenance", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true }
  ]
}
