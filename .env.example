# Copier ce fichier en .env et renseigner les valeurs (le .env n'est jamais versionné)

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=collector
POSTGRES_PASSWORD=change-me

# RabbitMQ
RABBITMQ_URL=amqp://collector:change-me@localhost:5672

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=collector
